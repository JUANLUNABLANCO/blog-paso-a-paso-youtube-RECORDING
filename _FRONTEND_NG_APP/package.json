{
  "name": "frontend",
  "version": "0.0.0",
  "engine": "node v20.0.0, ng v17.3.12, npm v11.3.0",
  "scripts": {
    "ng": "ng",
    "ng:build:prod": "rimraf ./dist && ng build --configuration=prod",
    "ng:build:dev": "ng build --configuration=dev",
    "ng:serve:dev": "ng serve  --open",
    "ng:serve:local": "ng serve --configuration=local --open",
    "ng:serve:test": "ng serve --configuration=test --open",
    "ng:serve:prod": "ng serve  --configuration=prod",
    "ng:serve:prod-local": "npx http-server -p 8080 --cors -c-1 dist",
    "ng:build-serve:prod-local": "rimraf ./dist && ng build --configuration=production && npx http-server -p 8080 -c-1 dist",
    "ng:test": "ng test",
    "ng:test:outbrowser": "ng test --browsers=ChromeHeadless",
    "ng:test:ci": "ng test --no-watch --code-coverage",
    "ng:lint": "ng lint",
    "ng:lint:fix": "ng lint --fix",
    "ng:format": "prettier --write \"src/**/*.ts\" \"src/**/*.html\"",
    "ng:format:check": "prettier --check \"src/**/*.ts\" \"src/**/*.html\""
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^17.3.12",
    "@angular/cdk": "^16.1.4",
    "@angular/common": "^17.3.12",
    "@angular/compiler": "^17.3.12",
    "@angular/core": "^17.3.12",
    "@angular/forms": "^17.3.12",
    "@angular/material": "^16.1.4",
    "@angular/platform-browser": "^17.3.12",
    "@angular/platform-browser-dynamic": "^17.3.12",
    "@angular/router": "^17.3.12",
    "@angular/service-worker": "^17.3.12",
    "@auth0/angular-jwt": "^5.1.2",
    "marked": "^12.0.2",
    "ngx-markdown": "^17.2.1",
    "prismjs": "^1.29.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.3.17",
    "@angular-eslint/builder": "17.5.3",
    "@angular-eslint/eslint-plugin": "17.5.3",
    "@angular-eslint/eslint-plugin-template": "17.5.3",
    "@angular-eslint/schematics": "17.5.3",
    "@angular-eslint/template-parser": "17.5.3",
    "@angular/cli": "~17.3.17",
    "@angular/compiler-cli": "^17.3.12",
    "@faker-js/faker": "^8.0.2",
    "@types/jasmine": "~4.3.0",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "cypress": "^12.17.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jasmine-core": "~4.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "pg": "^8.11.1",
    "prettier": "^3.0.3",
    "rimraf": "^5.0.1",
    "typescript": "~5.4.5"
  }
}
